# Copy to `.env` and fill in. `.env` is gitignored - never commit real keys.
# Nothing here is required for `make validate`, `make catalogue`, `make lint`
# or `make smoke` in mock mode. Keys are only needed once you serve a model.

# --- Local vLLM model server (scripts/serve_model.sh) ---
# OpenAI-compatible endpoint that vLLM exposes.
POLICY_BASE_URL=http://localhost:8000/v1
# vLLM ignores the value but the OpenAI client requires a non-empty string.
POLICY_API_KEY=dummy-not-a-real-key
POLICY_MODEL_NAME=Qwen/Qwen2.5-Coder-1.5B-Instruct

# --- Optional: hosted model for sanity-checking the harness ---
# Leave blank unless you are deliberately spending money.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Hugging Face ---
# Only needed for gated repos. Qwen2.5-Coder-1.5B-Instruct is not gated.
HF_TOKEN=
# Point this at a big disk; the default lives on C: on Windows.
HF_HOME=

# --- Experiment tracking (all optional, all off by default) ---
WANDB_API_KEY=
WANDB_PROJECT=rl-coding-agents
WANDB_MODE=disabled

# --- Paths ---
# Where a local clone of https://github.com/NVIDIA-NeMo/Gym lives, if you have one.
# Kept outside this repo on purpose (spec 3: no new top-level directories).
NEMO_GYM_PATH=../_vendor/nemo-gym
